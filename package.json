{
  "name": "dsh-pet",
  "description": "A DeepSeek desktop pet that floats over the DeepSeek Harness web GUI — animated moods, draggable, and chat answered by the running model. DSH 桌宠插件。",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "client/client.js",
    "cordis.patch.yml",
    "sprites/**/*.png"
  ]
}
